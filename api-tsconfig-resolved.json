{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "baseUrl": "../..",
        "paths": {
            "@sline/shared": [
                "./packages/shared/src/index.ts"
            ]
        },
        "outDir": "./dist",
        "moduleDetection": "force",
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "resolveJsonModule": true,
        "preserveConstEnums": true,
        "useDefineForClassFields": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./src/app.ts",
        "./src/audit.ts",
        "./src/augment-fastify.ts",
        "./src/auth.ts",
        "./src/index.ts",
        "./src/middleware/rbac.ts",
        "./src/routes/auth.test.ts",
        "./src/routes/auth.ts",
        "./src/routes/bookings.test.ts",
        "./src/routes/bookings.ts",
        "./src/routes/cases.test.ts",
        "./src/routes/cases.ts",
        "./src/routes/chat.test.ts",
        "./src/routes/chat.ts",
        "./src/routes/dashboard.test.ts",
        "./src/routes/dashboard.ts",
        "./src/routes/disputes.test.ts",
        "./src/routes/disputes.ts",
        "./src/routes/finance.test.ts",
        "./src/routes/finance.ts",
        "./src/routes/logs.test.ts",
        "./src/routes/logs.ts",
        "./src/routes/observability.test.ts",
        "./src/routes/observability.ts",
        "./src/routes/reports.test.ts",
        "./src/routes/reports.ts",
        "./src/routes/search.test.ts",
        "./src/routes/search.ts",
        "./src/routes/settings.test.ts",
        "./src/routes/settings.ts",
        "./src/routes/tasks.test.ts",
        "./src/routes/tasks.ts",
        "./src/routes/team.test.ts",
        "./src/routes/team.ts",
        "./src/routes/users.test.ts",
        "./src/routes/users.ts",
        "./src/routes/finance/approvals.ts",
        "./src/routes/finance/audit.ts",
        "./src/routes/finance/fee-settings.ts",
        "./src/routes/finance/metrics-summary.test.ts",
        "./src/routes/finance/metrics-summary.ts",
        "./src/routes/finance/transactions.ts",
        "./src/routes/finance/users.ts",
        "./src/routes/finance/wallets.ts",
        "./src/routes/finance/withdrawals.ts",
        "./src/routes/finance/workflow.ts"
    ],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
